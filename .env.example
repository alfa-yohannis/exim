# =============================================================================
# Exim RAG — contoh konfigurasi
# =============================================================================
# Salin berkas ini menjadi `.env`, lalu ubah seperlunya. Setiap baris di bawah
# menunjukkan NILAI BAWAAN, jadi berkas `.env` kosong pun sudah berjalan benar.
#
# PERINGATAN: `.env` dikecualikan dari kendali versi karena dapat memuat
# kredensial. Jangan menaruh kata sandi dalam bentuk teks biasa bila dapat
# dihindari, dan jangan membagikan berkas ini setelah diisi.
# =============================================================================

# --- Sumber dokumen ----------------------------------------------------------
# Korpus utama. SELALU dibuka baca-saja; sistem tidak pernah menulis ke sini.
SOURCE_DIR=G:\Shared drives\Tim Borang M.TI\Akreditasi\2026

# Direktori tambahan yang ikut diindeks, dipisahkan titik-koma (";").
# Titik-koma dipakai karena nama folder Windows lazim mengandung koma.
# `corpus-lokal` memuat salinan pemetaan dosen ke SINTA dan Google Scholar.
EXTRA_SOURCE_DIRS=corpus-lokal

# Semua artefak yang dihasilkan. Wajib berada DI LUAR korpus; server menolak
# berjalan bila pengaturan ini mengarah ke dalam SOURCE_DIR.
DATA_DIR=data

# --- Penyaringan berkas ------------------------------------------------------
# Nama direktori yang dilewati di mana pun ia berada.
EXCLUDE_DIRS=zdev,__pycache__,.git,.idea,.vscode,node_modules,.ipynb_checkpoints,venv,.venv

# Berkas di atas ukuran ini (MB) dilewati.
MAX_FILE_MB=200

# Selama server berjalan, korpus diperiksa tiap sekian detik dan berkas baru
# hasil crawl langsung diindeks. 0 = mati (indeks hanya lewat tombol/CLI).
AUTO_INGEST_SECONDS=60

# --- Pemotongan teks ---------------------------------------------------------
# Panjang target satu potongan, diukur dengan tokenizer model embedding.
CHUNK_TOKENS=450
# Token yang diulang antar potongan bertetangga agar fakta tidak terbelah.
CHUNK_OVERLAP_TOKENS=80
# Potongan yang lebih pendek dari ini dibuang sebagai derau (nomor halaman dsb).
MIN_CHUNK_CHARS=80

# --- Model embedding ---------------------------------------------------------
EMBED_MODEL=BAAI/bge-m3
# "auto" memilih cuda bila GPU tersedia, selain itu cpu.
EMBED_DEVICE=auto
EMBED_BATCH_SIZE=8
EMBED_DIM=1024

# --- Reranking ---------------------------------------------------------------
RERANK_ENABLED=1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# Sengaja "cpu": VRAM 8 GB sudah terpakai model bahasa; memuat reranker ke GPU
# berisiko kehabisan memori di tengah jawaban.
RERANK_DEVICE=cpu

# --- Pencarian ---------------------------------------------------------------
DENSE_CANDIDATES=40
SPARSE_CANDIDATES=40
RERANK_CANDIDATES=24
# Jumlah sumber yang masuk ke jawaban dan disitasi.
TOP_K=6
# Konstanta peredam reciprocal rank fusion.
RRF_K=60
# Batas atas karakter konteks yang diberikan ke model.
MAX_CONTEXT_CHARS=14000

# --- OCR (opsional) ----------------------------------------------------------
# Aktifkan setelah menjalankan: pip install rapidocr-onnxruntime
OCR_ENABLED=0
# Halaman PDF dengan karakter lebih sedikit dari ini dianggap hasil pindai.
OCR_PAGE_CHAR_THRESHOLD=60
OCR_DPI=200
OCR_MAX_PAGES_PER_DOC=80

# --- Model bahasa ------------------------------------------------------------
# Pilihan: ollama | claude_cli | codex_cli | antigravity_cli
# Hanya "ollama" yang menjaga teks dokumen tetap di komputer ini.
LLM_BACKEND=ollama

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# 8192 nyaman untuk VRAM 8 GB bersama Qwen3 8B Q4_K_M.
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=10m

# Suhu rendah menjaga jawaban tetap dekat dengan teks yang ditemukan.
TEMPERATURE=0.2
MAX_OUTPUT_TOKENS=1536

# --- CLI agen ----------------------------------------------------------------
# Setiap CLI disetel ke model terkuatnya pada tingkat penalaran tertinggi.
# Nama model diambil dari katalog masing-masing CLI:
#   claude --help | codex ~/.codex/models_cache.json | agy models
# Timeout dilebarkan karena jawaban effort tinggi bisa berjalan beberapa menit.

CLAUDE_CLI_PATH=claude
CLAUDE_CLI_MODEL=claude-opus-5
# low | medium | high | xhigh | max
CLAUDE_CLI_EFFORT=max
CLAUDE_CLI_TIMEOUT=900

CODEX_CLI_PATH=codex
CODEX_CLI_MODEL=gpt-5.6-sol
# low | medium | high | xhigh | max | ultra
# "ultra" juga mendelegasikan ke sub-agen — berlebihan untuk menjawab dari
# konteks yang sudah disediakan, jadi "max" adalah pilihan terdalam yang wajar.
CODEX_CLI_EFFORT=max
CODEX_CLI_TIMEOUT=900

ANTIGRAVITY_CLI_PATH=agy
# Katalog agy menyertakan tingkat effort di dalam nama model.
ANTIGRAVITY_CLI_MODEL=gemini-3.1-pro-high
# CLI ini hanya menerima low | medium | high
ANTIGRAVITY_CLI_EFFORT=high
ANTIGRAVITY_CLI_TIMEOUT=900

# --- Sumber eksternal (SINTA, Google Scholar, PDDikti, situs kampus) ---------
# Halaman eksternal disimpan sebagai salinan bertanggal ke corpus-lokal/eksternal
# lalu diindeks seperti dokumen biasa. Salinan dipakai, bukan pengambilan
# langsung, karena bukti akreditasi harus dapat diperiksa ulang: halaman web
# bisa berubah setelah dikutip.
#
#   .venv\Scripts\python.exe main.py snapshot              # pakai browser (lengkap)
#   .venv\Scripts\python.exe main.py snapshot --http-only  # tanpa browser
#
WEB_SNAPSHOT_DIR=corpus-lokal\eksternal
WEB_SNAPSHOT_TIMEOUT=45
# Jeda antar permintaan; Google Scholar menolak lalu lintas beruntun (429).
WEB_SNAPSHOT_DELAY=3.0
WEB_SNAPSHOT_MIN_CHARS=400

# --- Browser untuk sumber yang diproteksi ------------------------------------
# PDDikti dilindungi Cloudflare yang menolak browser apa pun yang dijalankan
# oleh Playwright — Chromium, Chrome, maupun Firefox, headless atau tidak.
# Karena itu Chrome dijalankan sebagai proses biasa lalu dilekati lewat DevTools.
# Chrome juga menolak debug pada profil bawaannya, sehingga berkas cookie
# disalin ke profil kerja terpisah.
#
# PENTING: tutup Chrome sebelum menjalankan snapshot — porta debug tidak dapat
# dipakai bersamaan.
BROWSER_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe
BROWSER_DEBUG_PORT=9222
BROWSER_PROFILE_SOURCE=C:\Users\Pradita\AppData\Local\Google\Chrome\User Data
BROWSER_PROFILE_COPY=data\browser-profile
BROWSER_TIMEOUT_MS=90000
BROWSER_SETTLE_MS=2500
BROWSER_BOT_CHECK_SECONDS=60
BROWSER_MAX_PAGES=15
# Direktori dosen kampus saja berisi sekitar delapan puluh halaman.
BROWSER_MAX_DETAILS=120

# Halaman awal yang selalu diambil, dipisahkan ";".
#
# Setiap entri berupa `url` atau `url::regex`, dengan regex menentukan tautan
# mana yang ditelusuri dari halaman itu. Polanya per-seed karena situsnya
# berbeda: isi PDDikti ada di balik halaman /detail-.../, sedangkan situs kampus
# menaruh satu halaman per dosen di bawah /praktisi-akademisi/dosen/. Satu pola
# bersama akan diam-diam tidak menelusuri apa pun di salah satunya.
#
# Pemisahnya "::" (bukan ":" tunggal) agar tidak tertukar dengan "https://".
BROWSER_SEED_URLS=https://pddikti.kemdiktisaintek.go.id/search/Universitas%20Pradita::/detail-(dosen|prodi|pt|mahasiswa)/;https://www.pradita.ac.id/praktisi-akademisi::/praktisi-akademisi/dosen/;https://www.pradita.ac.id/

# Pola cadangan untuk seed yang tidak membawa polanya sendiri.
BROWSER_DETAIL_PATTERN=/detail-(dosen|prodi|pt|mahasiswa)/

# --- Login SINTA -------------------------------------------------------------
# Diperlukan agar daftar publikasi halaman ke-2 dan seterusnya terlihat.
# Tanpa ini hanya halaman pertama yang tersalin.
SINTA_USER=
SINTA_PASS=
SINTA_LOGIN_URL=https://sinta.kemdiktisaintek.go.id/logins

# --- Percakapan --------------------------------------------------------------
# Giliran sebelumnya yang diputar ulang ke model agar pertanyaan lanjutan
# ("siapa saja mereka?") tetap dapat dipahami. Empat = dua kali tanya-jawab.
HISTORY_TURNS=4
MAX_HISTORY_CHARS=2500
# Pertanyaan lebih pendek dari ini (dalam kata) dianggap pertanyaan lanjutan dan
# digabung dengan pertanyaan sebelumnya saat pencarian.
FOLLOW_UP_WORDS=6

# --- Server web --------------------------------------------------------------
# Bawaan hanya loopback. Korpus ini bersifat internal — pertimbangkan masak-masak
# sebelum membukanya ke jaringan.
HOST=127.0.0.1
PORT=8029
# Mengizinkan antarmuka meminta server membuka berkas yang disitasi.
ALLOW_OPEN_FILE=1

# --- Login -------------------------------------------------------------------
# Hanya dua peran, masing-masing satu akun dengan kata sandi: admin dan guest.
# Guest dapat bertanya dan menelusuri, tetapi tidak dapat memperbarui atau
# membangun ulang indeks.
# Kata sandi disimpan sebagai hash PBKDF2 — aslinya tidak pernah disimpan.
# Buat hash baru dengan:  python main.py hash-password
# Kosongkan hash untuk memakai kata sandi bawaan.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
GUEST_USERNAME=guest
GUEST_PASSWORD_HASH=
# Kunci penanda tangan cookie sesi. Kosongkan agar dibuat acak dan disimpan di
# data/session-secret.key (login tetap berlaku setelah server dimulai ulang).
SESSION_SECRET=
# Lama sesi login berlaku, dalam jam.
SESSION_HOURS=12
